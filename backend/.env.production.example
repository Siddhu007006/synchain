# ===========================================================================
# SynChain Production Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in production values.
# NEVER commit .env with real secrets to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------
# PostgreSQL connection string for production.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://synchain:CHANGE_ME@localhost:5432/synchain

# ---------------------------------------------------------------------------
# Authentication (REQUIRED)
# ---------------------------------------------------------------------------
# CRITICAL: Generate a unique 256-bit secret for production.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_256_BIT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
DEBUG=false
APP_VERSION=4.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# CORS — restrict to your production frontend URL
# ---------------------------------------------------------------------------
CORS_ORIGINS=["https://your-app.example.com"]
ALLOWED_HOSTS=["your-app.example.com", "api.your-app.example.com"]

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10
RATE_LIMIT_WRITE=30
RATE_LIMIT_READ=120
RATE_LIMIT_ADMIN=20

# ---------------------------------------------------------------------------
# Database Pool (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Audit
# ---------------------------------------------------------------------------
AUDIT_ARCHIVE_DAYS=90

# ---------------------------------------------------------------------------
# External API Keys (optional — leave empty for synthetic fallback)
# ---------------------------------------------------------------------------
EXTERNAL_PROVIDER_MODE=auto
NEWSAPI_KEY=
OPENWEATHERMAP_KEY=
ALPHAVANTAGE_KEY=
FRED_KEY=

# ---------------------------------------------------------------------------
# Security Checklist
# ---------------------------------------------------------------------------
# [ ] JWT_SECRET_KEY is a unique, cryptographically random value
# [ ] DATABASE_URL points to a production PostgreSQL instance
# [ ] DEBUG=false
# [ ] CORS_ORIGINS is restricted to your frontend domain
# [ ] .env is NOT committed to version control
# [ ] Alembic migrations have been run: alembic upgrade head
# [ ] Gunicorn is used as the process manager
# [ ] HTTPS is enforced via reverse proxy (Nginx, Cloudflare, etc.)
