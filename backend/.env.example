# ============================================
# SynChain Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---- Core ----
DATABASE_URL=sqlite:///./supply_chain.db
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ---- Authentication ----
# REQUIRED in production (DEBUG=false).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- External Intelligence API Keys (Optional) ----
# Leave empty to use synthetic fallback data.
NEWSAPI_KEY=
OPENWEATHERMAP_KEY=
ALPHAVANTAGE_KEY=
FRED_KEY=

# Provider mode: "auto" | "synthetic" | "real"
EXTERNAL_PROVIDER_MODE=auto

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10
RATE_LIMIT_WRITE=30
RATE_LIMIT_READ=120
RATE_LIMIT_ADMIN=20

# ---- Production (PostgreSQL) ----
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT=30
# ALLOWED_HOSTS=["your-domain.com"]
# SECURE_COOKIES=true
